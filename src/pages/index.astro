---
import Layout from "../layouts/main.astro";
import { Hero } from "@/components/Hero";
import { ProductDemo } from "@/components/ProductDemo";
import { HowItWorks } from "@/components/HowItWorks";
import { Features } from "@/components/Features";
import { UseCases } from "@/components/UseCases";
import { Architecture } from "@/components/Protocol";
import { PlatformSupport } from "@/components/IDESupport";
import { MobileShowcase } from "@/components/MobileShowcase";
import { FreeAndOpen } from "@/components/Pricing";
import { Roadmap } from "@/components/Roadmap";
import { FAQ } from "@/components/FAQ";
import { ScrollToTop } from "@/components/ScrollToTop";
---

<Layout>
	<Hero client:load />
	<ProductDemo client:visible />
	<HowItWorks client:load />
	<Features client:load />
	<UseCases client:load />
	<Architecture client:load />
	<PlatformSupport client:load />
	<MobileShowcase client:load />
	<FreeAndOpen client:load />
	<Roadmap client:load />
	<FAQ client:load />
	<ScrollToTop client:load />
</Layout>
