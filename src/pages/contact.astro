---
import Layout from "../layouts/main.astro";
import { BookOpen, GitFork } from "lucide-react";

const title = "Contact — apprenti.dev";
---

<Layout {title}>
    <section class="py-20 md:py-32">
        <div class="container mx-auto px-4">
            <div class="max-w-3xl mx-auto">
                <div class="text-center space-y-4 mb-12">
                    <h1 class="text-4xl md:text-5xl font-bold">
                        Get in{" "}
                        <span
                            class="bg-gradient-to-r from-apprenti-violet to-apprenti-magenta bg-clip-text text-transparent"
                        >
                            touch
                        </span>
                    </h1>
                    <p class="text-lg text-muted-foreground max-w-xl mx-auto">
                        apprenti.dev is an open, Git-native project with no
                        support team behind it. The application repository
                        isn't public yet — once it is, this page will link
                        straight to Discussions and Issues. Until then, here's
                        where to start.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <a
                        href="/docs"
                        class="group p-8 rounded-2xl border border-border/50 bg-card/50 backdrop-blur-sm shadow-lg shadow-apprenti-violet/5 hover:border-apprenti-violet/50 transition-colors"
                    >
                        <div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-apprenti-violet to-apprenti-magenta mb-4">
                            <BookOpen class="h-6 w-6 text-white" />
                        </div>
                        <h2 class="text-xl font-semibold mb-2">
                            Browse the docs
                        </h2>
                        <p class="text-muted-foreground mb-4">
                            Most questions about how apprenti.dev works — for
                            apprentices, mentors, or curriculum content
                            creators — are answered in the documentation hub.
                        </p>
                        <span class="text-sm font-medium text-primary group-hover:underline">
                            Open the docs →
                        </span>
                    </a>

                    <a
                        href="/curricula"
                        class="group p-8 rounded-2xl border border-border/50 bg-card/50 backdrop-blur-sm shadow-lg shadow-apprenti-violet/5 hover:border-apprenti-violet/50 transition-colors"
                    >
                        <div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-apprenti-magenta to-apprenti-peach mb-4">
                            <GitFork class="h-6 w-6 text-white" />
                        </div>
                        <h2 class="text-xl font-semibold mb-2">
                            Explore the curriculum
                        </h2>
                        <p class="text-muted-foreground mb-4">
                            The Software Engineering apprenticeship curriculum
                            is already open on GitHub — fork it, open an issue
                            against it, or start a discussion there directly.
                        </p>
                        <span class="text-sm font-medium text-primary group-hover:underline">
                            View the curricula catalog →
                        </span>
                    </a>
                </div>

                <p class="text-center text-sm text-muted-foreground mt-10">
                    Prefer self-serve? Read the{" "}
                    <a href="/about" class="text-link hover:underline">story behind apprenti.dev</a>
                    {" "}or check the{" "}
                    <a href="/#faq" class="text-link hover:underline">FAQ</a>.
                </p>
            </div>
        </div>
    </section>
</Layout>
