---
import Layout from "../layouts/main.astro";
import CatalogGuideLinks from "../components/CatalogGuideLinks.astro";
import { GitFork } from "lucide-react";
import { catalogRepos, curriculumCount } from "../lib/catalog";
---

<Layout title="Curricula Catalog — apprenti.dev">
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<div class="text-center space-y-4 mb-12">
					<h1 class="text-4xl md:text-6xl font-bold">
						The{" "}
						<span class="bg-gradient-to-r from-apprenti-violet to-apprenti-magenta bg-clip-text text-transparent">
							curricula
						</span>{" "}
						catalog
					</h1>
					<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
						apprenti.dev is curriculum-agnostic — a curriculum is just a Git
						repository. Pick a repo to see what's inside.
					</p>
				</div>

				<div class="mb-12">
					<h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground mb-3">
						How to use this catalog
					</h2>
					<CatalogGuideLinks />
				</div>

				<div class="space-y-6 mb-20">
					{catalogRepos.map((repo) => (
						<a
							href={`/curricula/${repo.slug}`}
							class="block rounded-2xl border border-border/50 bg-card/50 backdrop-blur-sm shadow-lg shadow-apprenti-violet/5 p-8 hover:bg-accent/30 transition-colors"
						>
							<div class="flex flex-wrap items-center gap-3 mb-3">
								<h2 class="text-2xl font-bold">
									{repo.owner}/{repo.name}
								</h2>
								<span class="inline-flex items-center rounded-full border border-apprenti-violet/30 bg-apprenti-violet/10 px-3 py-1 text-xs font-semibold text-apprenti-violet-on-dark">
									{repo.badge}
								</span>
							</div>
							<p class="text-muted-foreground leading-relaxed mb-4">
								{repo.description}
							</p>
							<p class="text-sm font-medium">
								{curriculumCount(repo)} curricula →
							</p>
						</a>
					))}
				</div>

				<p class="text-center text-sm text-muted-foreground mb-16 max-w-2xl mx-auto">
					More repositories will appear here as mentors and content creators
					publish their own — see
					<a href="/docs/creator-publishing-forking" class="text-link hover:underline">Publishing &amp; forking a curriculum</a>
					and the
					<a href="/curricula/guides/listing" class="text-link hover:underline">listing rules</a>
					if you'd like yours added.
				</p>

				<div class="text-center pt-12 border-t">
					<div class="inline-flex items-center gap-2 rounded-full border border-apprenti-cyan/30 bg-apprenti-cyan/10 px-4 py-1.5 text-sm font-semibold text-apprenti-cyan mb-6">
						<GitFork class="h-4 w-4" />
						Free forever — fork anything, anytime
					</div>
					<h2 class="text-2xl md:text-3xl font-bold mb-4">Ready to open a curriculum?</h2>
					<p class="text-muted-foreground mb-6 max-w-xl mx-auto">
						Read the full docs for your role, or open a listed repository.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/docs" class="inline-flex items-center justify-center h-10 px-6 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors">
							Read the docs
						</a>
						<a href="/curricula/guides/opening" class="inline-flex items-center justify-center h-10 px-6 rounded-md border bg-background hover:bg-accent hover:text-accent-foreground transition-colors">
							How to open one
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
	<script is:inline>
		if (location.hash === "#listing-rules") {
			location.replace("/curricula/guides/listing");
		}
	</script>
</Layout>
