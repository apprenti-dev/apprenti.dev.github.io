---
import Layout from "../../../layouts/main.astro";
import CatalogGuideLinks from "../../../components/CatalogGuideLinks.astro";
import { FolderGit2, HardDrive } from "lucide-react";
---

<Layout title="Opening a curriculum — apprenti.dev">
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<p class="text-sm text-muted-foreground mb-6">
					<a href="/curricula" class="text-link hover:underline">Curricula catalog</a>
					<span class="mx-1.5">/</span>
					<span>Opening a curriculum</span>
				</p>

				<div class="space-y-4 mb-12">
					<h1 class="text-4xl md:text-5xl font-bold">Opening a curriculum in the app</h1>
					<p class="text-lg text-muted-foreground max-w-2xl">
						Whichever role you're in, apprenti.dev opens a curriculum the same
						way — from <strong class="text-foreground">More</strong> in the app.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
					<div class="rounded-2xl border border-border/50 bg-card/50 p-6">
						<div class="inline-flex p-2.5 rounded-xl bg-apprenti-cyan/15 mb-4">
							<FolderGit2 class="h-5 w-5 text-apprenti-cyan" />
						</div>
						<h2 class="font-semibold mb-2">Clone repository</h2>
						<p class="text-sm text-muted-foreground leading-relaxed">
							Paste a GitHub or GitLab HTTPS URL — your fork of a listed
							curriculum, or any other curriculum repository. Public
							repositories clone without a token; private ones (and pushing
							your own work) need a personal access token with read/write
							access to repository contents, stored only in this device's
							secure storage.
						</p>
					</div>
					<div class="rounded-2xl border border-border/50 bg-card/50 p-6">
						<div class="inline-flex p-2.5 rounded-xl bg-apprenti-peach/15 mb-4">
							<HardDrive class="h-5 w-5 text-apprenti-peach" />
						</div>
						<h2 class="font-semibold mb-2">Open local repository</h2>
						<p class="text-sm text-muted-foreground leading-relaxed">
							Already have a curriculum folder on this device — cloned
							yourself, or handed to you directly? Point the app at it and it
							works fully offline from there, with no remote required until
							you choose to sync.
						</p>
					</div>
				</div>

				<p class="text-sm text-muted-foreground mb-12">
					Need the full walkthrough?
					<a href="/docs/apprentice-getting-started" class="text-link hover:underline">Getting started as an apprentice</a>
					covers clone, local folders, and the first sync.
				</p>

				<div>
					<h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground mb-3">
						Related guides
					</h2>
					<CatalogGuideLinks />
				</div>
			</div>
		</div>
	</section>
</Layout>
