---
import DocsLayout from "../../layouts/docs.astro";
---

<DocsLayout title="apprenti.dev Documentation">
    <div class="space-y-8">
        <div>
            <h1 class="text-3xl md:text-4xl font-bold">Documentation</h1>
            <p class="text-muted-foreground mt-2">
                Guides for apprentices, mentors, and curriculum content
                creators — apprenti.dev is Git-native, so these are guides to
                files and workflows, not a hosted product manual.
            </p>
        </div>

        <!-- Search -->
        <div class="relative">
            <input
                type="text"
                id="docs-search"
                placeholder="Search documentation..."
                class="w-full rounded-xl border border-border/50 bg-muted/30 px-4 py-3 pl-10 text-sm placeholder:text-muted-foreground/50 focus:outline-none focus:ring-2 focus:ring-apprenti-violet-on-dark/50"
            />
            <svg
                class="absolute left-3 top-3.5 h-4 w-4 text-muted-foreground/50"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                ></path>
            </svg>
        </div>

        <!-- For Apprentices -->
        <div class="space-y-4" data-docs-category id="apprentices">
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-apprenti-violet-on-dark"
                ></span>
                For Apprentices
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/apprentice-getting-started"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="Getting started Apprentice clone repository offline"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Getting started
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Open or clone a curriculum repository and start
                            working offline.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-working-through-your-path"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="Working through your path Today Path task work notes time logs"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Working through your path
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Today, Path, task work, notes, and time logs.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-submitting-evidence"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="Submitting evidence for review revisions mentor"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Submitting evidence for review
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Build a submission your mentor can inspect, then
                            track revisions.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-using-ai-assistance"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="Using AI assistance AI tab task assistants prompts"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Using AI assistance
                        </p>
                        <p class="text-xs text-muted-foreground">
                            What the AI tab and task assistants can and cannot
                            do, and where your prompts go.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-ai-assistance-modes"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="The five AI assistance modes explain hint quiz coach solution"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            The five AI assistance modes
                        </p>
                        <p class="text-xs text-muted-foreground">
                            What explain, hint, quiz, coach, and solution
                            each actually do.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-private-forks"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all"
                    data-doc-title="Keeping your fork private GitHub GitLab visibility"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Keeping your fork private
                        </p>
                        <p class="text-xs text-muted-foreground">
                            GitHub keeps forks of public repos public;
                            GitLab lets you choose. What to do on each.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/apprentice-search"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-violet-on-dark/30 transition-all md:col-span-2"
                    data-doc-title="Search across your curriculum find task resource note offline"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-violet-on-dark"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-violet-on-dark transition-colors"
                        >
                            Search across your curriculum
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Find any task, resource, or note instantly, fully
                            offline.
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <!-- For Mentors -->
        <div class="space-y-4" data-docs-category id="mentors">
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-apprenti-cyan"></span>
                For Mentors
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/mentor-reviewing-submissions"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-cyan/30 transition-all"
                    data-doc-title="Reviewing submissions review inbox approve request revision discuss"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-cyan transition-colors"
                        >
                            Reviewing submissions
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Work the review inbox: approve, request revision,
                            or discuss.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/mentor-mentoring-communication"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-cyan/30 transition-all"
                    data-doc-title="Mentoring communication threads feedback help requests"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-cyan transition-colors"
                        >
                            Mentoring & communication
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Threads, feedback, and help requests, with no
                            server in the middle.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/mentor-setting-up-repository"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-cyan/30 transition-all"
                    data-doc-title="Setting up a curriculum repository clone GitHub GitLab private"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-cyan transition-colors"
                        >
                            Setting up a curriculum repository
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Clone from GitHub or GitLab, and understand what
                            stays private.
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/mentor-competency-growth"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-cyan/30 transition-all"
                    data-doc-title="Tracking competency growth approved evidence defensible record"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-apprenti-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-apprenti-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-apprenti-cyan transition-colors"
                        >
                            Tracking competency growth
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Turn approved evidence into a defensible record of
                            what an apprentice can do.
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <!-- For Content Creators -->
        <div class="space-y-4" data-docs-category id="creators">
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-apprenti-magenta"
                ></span>
                For Content Creators
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/creator-curriculum-structure"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-apprenti-magenta/30 transition-all"
